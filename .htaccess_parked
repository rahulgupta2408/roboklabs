# ============================================================
# Robok Labs - .htaccess  (clean, no-WordPress version)
# Works with folder-based URLs:  /about -> /about/index.html
# ============================================================

# ------------------------------------------------------------
# 1) Tell the server index.html is the default page
# ------------------------------------------------------------
DirectoryIndex index.html index.htm

# ------------------------------------------------------------
# 2) Force HTTPS + non-www canonical host
# ------------------------------------------------------------
<IfModule mod_rewrite.c>
  RewriteEngine On

  # Force HTTPS
  RewriteCond %{HTTPS} off
  RewriteRule ^(.*)$ https://%{HTTP_HOST}/$1 [R=301,L]

  # Canonical host: force non-www (remove this block if you prefer www.)
</IfModule>

# ------------------------------------------------------------
# 3) 301-redirect old .html URLs to clean URLs  (SEO safe)
#    /about.html  ->  /about
# ------------------------------------------------------------
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Only trigger on the original request (not internal rewrites).
  # Skip /index.html so the root page keeps working.
  RewriteCond %{THE_REQUEST} \s/+(?!index\.html)([^\s?]+)\.html[\s?] [NC]
  RewriteRule ^ /%1 [R=301,L,NE]
</IfModule>

# ------------------------------------------------------------
# 4) Custom error page (optional)
# ------------------------------------------------------------
ErrorDocument 404 /index.html

# ------------------------------------------------------------
# 5) GZIP compression (speed + SEO)
# ------------------------------------------------------------
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css text/javascript
  AddOutputFilterByType DEFLATE application/javascript application/x-javascript
  AddOutputFilterByType DEFLATE application/xml application/rss+xml application/xhtml+xml
  AddOutputFilterByType DEFLATE application/json image/svg+xml image/x-icon
  AddOutputFilterByType DEFLATE font/ttf font/otf font/woff font/woff2
</IfModule>

# ------------------------------------------------------------
# 6) Browser caching
# ------------------------------------------------------------
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresDefault "access plus 1 hour"
  ExpiresByType text/html "access plus 1 hour"
  ExpiresByType text/css  "access plus 1 year"
  ExpiresByType text/javascript "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/png  "access plus 1 year"
  ExpiresByType image/gif  "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType image/x-icon "access plus 1 year"
  ExpiresByType font/woff  "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
</IfModule>

# ------------------------------------------------------------
# 7) Security / SEO response headers
# ------------------------------------------------------------
<IfModule mod_headers.c>
  Header set X-Content-Type-Options "nosniff"
  Header set X-Frame-Options "SAMEORIGIN"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
  Header set Permissions-Policy "geolocation=(), microphone=(), camera=()"
</IfModule>
